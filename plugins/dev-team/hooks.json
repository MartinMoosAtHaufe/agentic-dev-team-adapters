{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook SessionStart",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook SessionStart",
        "timeoutSec": 130
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook UserPromptSubmit",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook UserPromptSubmit",
        "timeoutSec": 40
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook PreToolUse",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook PreToolUse",
        "timeoutSec": 730
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook PostToolUse",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook PostToolUse",
        "timeoutSec": 400
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook SessionEnd",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook SessionEnd",
        "timeoutSec": 40
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook Stop",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook Stop",
        "timeoutSec": 40
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook SubagentStop",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook SubagentStop",
        "timeoutSec": 100
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook subagentStart",
        "bash": "python3 \"${PLUGIN_ROOT}/_copilot_adapter.py\" hook subagentStart",
        "timeoutSec": 30
      }
    ]
  }
}
