{
  "name": "pi-dev-team",
  "version": "13.1.0",
  "description": "Pi Coding Agent port of the dev-team persona-driven AI development plugin",
  "author": "Martin Moos",
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/subagent/index.ts"
    ],
    "skills": [
      "../../plugins/dev-team/skills/*"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/index.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
